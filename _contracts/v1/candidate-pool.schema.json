{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief/contracts/v1/candidate-pool.schema.json",
  "title": "Daily AI Brief editorial candidate pool",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_set_id", "brief_date", "generated_at", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_set_id": {"type": "string", "pattern": "^dab-candidates-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{8}$"},
    "brief_date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "candidates": {"type": "array", "minItems": 20, "maxItems": 30, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "focus", "headline", "selected", "selected_ordinal", "source", "score", "novelty_check", "selection_rationale", "rejection_reason"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^dab-candidate-"},
        "focus": {"enum": ["technical_ai_engineering", "applied_genai_knowledge_workers", "agents_non_technical_people"]},
        "headline": {"type": "string", "minLength": 1},
        "selected": {"type": "boolean"},
        "selected_ordinal": {"type": ["integer", "null"], "minimum": 1, "maximum": 6},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "normalized_url", "evidence_type", "availability_status"],
          "properties": {
            "url": {"type": "string", "format": "uri"},
            "normalized_url": {"type": "string", "format": "uri"},
            "evidence_type": {"enum": ["official_announcement", "official_documentation", "official_changelog", "official_repository", "research_paper", "standard_or_government", "independent_evaluation", "authoritative_reporting", "practitioner_analysis"]},
            "availability_status": {"enum": ["general_availability", "public_preview", "limited_preview", "beta", "alpha", "research", "announced", "reported", "proposed", "deprecated", "not_applicable"]}
          }
        },
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["significance", "freshness", "authority", "evidence_quality", "novelty", "practical_value", "category_fit", "total", "rationale"],
          "properties": {
            "significance": {"type": "integer", "minimum": 0, "maximum": 5},
            "freshness": {"type": "integer", "minimum": 0, "maximum": 5},
            "authority": {"type": "integer", "minimum": 0, "maximum": 5},
            "evidence_quality": {"type": "integer", "minimum": 0, "maximum": 5},
            "novelty": {"type": "integer", "minimum": 0, "maximum": 5},
            "practical_value": {"type": "integer", "minimum": 0, "maximum": 5},
            "category_fit": {"type": "integer", "minimum": 0, "maximum": 5},
            "total": {"type": "integer", "minimum": 0, "maximum": 35},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "novelty_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "matches", "prior_story_ids", "what_changed"],
          "properties": {
            "disposition": {"enum": ["new", "material_update", "approved_repeat"]},
            "matches": {"type": "array", "items": {"type": "object"}},
            "prior_story_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^dab-story-"}},
            "what_changed": {"type": ["string", "null"]}
          }
        },
        "selection_rationale": {"type": ["string", "null"]},
        "rejection_reason": {"type": ["string", "null"]},
        "learning_adjustment": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["learning_id", "mode", "base_total", "adjusted_total"],
          "properties": {
            "learning_id": {"type": "string", "pattern": "^dab-editorial-learning-"},
            "mode": {"enum": ["shadow", "active"]},
            "base_total": {"type": "number", "minimum": 0},
            "adjusted_total": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
