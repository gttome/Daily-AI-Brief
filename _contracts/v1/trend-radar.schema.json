{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/Daily-AI-Brief/contracts/v1/trend-radar.schema.json",
  "title": "Daily AI Brief Trend Radar snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_date", "method_version", "evidence_window", "trends"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_date": {"type": "string", "format": "date"},
    "method_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "evidence_window": {"type": "object", "required": ["start_date", "end_date", "days"], "properties": {"start_date": {"type": "string", "format": "date"}, "end_date": {"type": "string", "format": "date"}, "days": {"type": "integer", "minimum": 7, "maximum": 30}}, "additionalProperties": false},
    "trends": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trend_id", "name", "classification", "confidence", "rationale", "evidence_counts", "supporting_story_ids", "supporting_stories"],
        "properties": {
          "trend_id": {"type": "string", "pattern": "^dab-trend-[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "classification": {"enum": ["accelerating", "emerging", "stable", "cooling"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidence_counts": {"type": "object", "additionalProperties": false, "required": ["recent_7_days", "preceding_days", "total"], "properties": {"recent_7_days": {"type": "integer", "minimum": 0}, "preceding_days": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 1}}},
          "supporting_story_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^dab-(story|podcast)-"}},
          "supporting_stories": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["story_id", "brief_date", "url"], "properties": {"story_id": {"type": "string", "pattern": "^dab-(story|podcast)-"}, "brief_date": {"type": "string", "format": "date"}, "url": {"type": "string", "pattern": "^/(stories|podcasts)/"}}}}
        }
      }
    }
  }
}
