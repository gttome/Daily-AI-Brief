{
  "schema_version": "1.0.0",
  "principle": "minimum_sufficient_affected_tests_before_full_publication_ci",
  "tiers": {
    "A": {
      "target": "seconds",
      "purpose": "pure unit, schema, invariant and targeted regression tests"
    },
    "B": {
      "target": "low_minutes",
      "purpose": "affected component integrations"
    },
    "C": {
      "target": "under_10_minutes",
      "purpose": "full deterministic publication CI for integrated candidates or shared-core changes"
    },
    "D": {
      "target": "under_5_minutes",
      "purpose": "post-deployment exact-SHA and live-reader verification"
    },
    "E": {
      "target": "explicitly_bounded",
      "purpose": "failure injection and major-wave qualification only"
    }
  },
  "rules": [
    {
      "patterns": [
        "_generator/lib/book-selection.mjs",
        "_generator/lib/book-reading.mjs",
        "_data/book-reading.json",
        "_generator/lib/emerging-discovery.mjs",
        "_generator/lib/emerging-signal-sweep.mjs",
        "_data/emerging-signal-policy.json",
        "_tools/validate-intelligence.mjs",
        "_tools/book-selection.mjs",
        "assets/js/watchlist-daily.js"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/book-selection.test.mjs",
        "_generator/test/book-reading.test.mjs",
        "_generator/test/emerging-discovery.test.mjs",
        "_generator/test/emerging-signal-sweep.test.mjs",
        "_generator/test/watchlist-daily-state.test.mjs",
        "_generator/test/publication-manifest.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/durable-operation.mjs",
        "_generator/lib/recoverable-image-job.mjs",
        "_generator/lib/connector-image-delivery.mjs",
        "_generator/lib/edition-execution.mjs",
        "_tools/edition-execution.mjs",
        "_generator/test/reliable-execution.test.mjs",
        "docs/operations/reliable-edition-execution.md"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/reliable-execution.test.mjs",
        "_generator/test/image-execution.test.mjs",
        "_generator/test/native-image-delivery.test.mjs",
        "_generator/test/run-state-recovery.test.mjs",
        "_generator/test/publication-manifest.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/test/image-transport-parity.test.mjs",
        "docs/operations/under80-runtime-contract.json",
        "docs/operations/efficiency-operating-policy.json",
        "docs/operations/image-file-transfer.md"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/image-transport-parity.test.mjs",
        "_generator/test/image-execution.test.mjs",
        "_generator/test/native-image-delivery.test.mjs",
        "_generator/test/github-image-transfer.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/github-image-transfer.mjs",
        "_tools/github-image-transfer.mjs",
        "_tools/verify-image-transfer.mjs",
        "_generator/test/github-image-transfer.test.mjs",
        ".github/actions/transfer-image/action.yml",
        "docs/operations/image-file-transfer.md"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/github-image-transfer.test.mjs",
        "_generator/test/image-execution.test.mjs",
        "_generator/test/image-quality-gate.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/native-image-delivery.mjs",
        "_tools/native-image-delivery.mjs",
        "_generator/test/native-image-delivery.test.mjs",
        "docs/operations/native-image-task-delivery.md"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/native-image-delivery.test.mjs",
        "_generator/test/image-execution.test.mjs",
        "_generator/test/image-quality-gate.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/image-gate.mjs",
        "_tools/validate-handoff-images.mjs",
        "_records/image-quality/benchmark-profile-v1.json",
        "_generator/test/image-quality-gate.test.mjs",
        "docs/images/publisher-policy.md",
        "_tools/daily-validation.mjs"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/image-quality-gate.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/publication-manifest.mjs",
        "_tools/publication-manifest.mjs",
        "_records/editorial-handoff/publication-manifest.json",
        ".github/workflows/post-editorial-kernel.yml",
        "_tools/sync-public-watchlist.mjs"
      ],
      "tier": "B",
      "tests": [
        "_generator/test/publication-manifest.test.mjs",
        "_generator/test/under80-handoff-transport.test.mjs"
      ]
    },
    {
      "patterns": [
        ".github/workflows/post-editorial-kernel.yml"
      ],
      "tier": "B",
      "tests": [
        "_generator/test/run-state-recovery.test.mjs",
        "_generator/test/under80-handoff-transport.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/run-state.mjs",
        "_tools/run-state.mjs",
        "_generator/test/run-state-recovery.test.mjs"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/run-state-recovery.test.mjs",
        "_generator/test/sep24-reliability.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/publication-lifecycle.mjs",
        "_tools/publication-lifecycle.mjs",
        "data/operations/current-edition.json",
        "data/operations/publication-status.json",
        "_records/publication/*/lifecycle.json",
        "_records/publication/*/completion.json"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/publication-lifecycle.test.mjs"
      ]
    },
    {
      "patterns": [
        "_tools/daily-validation.mjs",
        ".github/workflows/daily-delta-validation.yml"
      ],
      "tier": "B",
      "tests": [
        "_generator/test/publication-lifecycle.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/render.mjs"
      ],
      "tier": "B",
      "tests": [
        "_generator/test/publication-lifecycle.test.mjs",
        "_generator/test/publication.test.mjs"
      ]
    },
    {
      "patterns": [
        ".github/workflows/ci.yml",
        "_generator/lib/publication.mjs",
        "_generator/validate-commit.mjs"
      ],
      "tier": "C",
      "tests": [
        "_generator/test/publication-lifecycle.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/command-center-delta.mjs",
        "_tools/command-center-delta.mjs",
        "_generator/test/command-center-delta.test.mjs"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/command-center-delta.test.mjs",
        "_generator/test/publication-lifecycle.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/reliability-proof.mjs",
        "_tools/reliability-proof.mjs",
        "_generator/test/reliability-proof.test.mjs",
        "_records/reliability-proof/wave5/*",
        "docs/operations/RELIABILITY_ITERATION5_*"
      ],
      "tier": "E",
      "tests": [
        "_generator/test/reliability-proof.test.mjs",
        "_generator/test/run-state-recovery.test.mjs",
        "_generator/test/publication-lifecycle.test.mjs",
        "_generator/test/command-center-delta.test.mjs",
        "_generator/test/image-quality-gate.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/publication-candidate-lint.mjs",
        "_generator/test/publication-candidate-lint.test.mjs"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/publication-candidate-lint.test.mjs",
        "_generator/test/image-quality-gate.test.mjs"
      ]
    },
    {
      "tier": "image-execution-parity",
      "patterns": [
        "_generator/lib/image-execution.mjs",
        "_generator/lib/image-story-packet.mjs",
        "_generator/lib/qualification-image-harness.mjs",
        "_generator/lib/image-gate.mjs",
        "_tools/image-execution.mjs",
        "docs/operations/automated-image-execution.md",
        "docs/operations/continuous-qualification-contract.json"
      ],
      "tests": [
        "_generator/test/image-execution.test.mjs",
        "_generator/test/image-quality-gate.test.mjs",
        "_generator/test/qualification-image-harness.test.mjs",
        "_generator/test/qualification-image-subject-lock.test.mjs",
        "_generator/test/continuous-qualification-contract.test.mjs"
      ]
    },
    {
      "patterns": [
        "_generator/lib/run-supervisor.mjs",
        "_generator/lib/operational-learning.mjs",
        "_generator/lib/run-readiness.mjs",
        "_tools/run-supervisor.mjs",
        "_tools/operational-learning.mjs",
        "_generator/validate-ledgers.mjs",
        "docs/operations/task-recovery-contracts.json",
        "docs/operations/run-learning-readiness-contract.json",
        "docs/operations/RUN-LEARNING-READINESS-PLAN.md",
        "data/operations/production-continuous-improvement-ledger.jsonl",
        ".github/workflows/run-supervisor.yml",
        ".github/workflows/run-supervisor-watchdog.yml"
      ],
      "tier": "A",
      "tests": [
        "_generator/test/run-supervisor.test.mjs",
        "_generator/test/operational-learning.test.mjs",
        "_generator/test/run-readiness.test.mjs",
        "_generator/test/reliable-execution.test.mjs",
        "_generator/test/run-state-recovery.test.mjs"
      ]
    }
  ],
  "sentinel_cases": [
    "normal_success",
    "missing_completion",
    "wrong_live_reader_date",
    "deployed_sha_mismatch",
    "interrupted_publication_resume",
    "checkpoint_output_mutation",
    "checkpoint_dependency_mutation",
    "duplicate_consequential_action",
    "publication_manifest_wrong_schema",
    "publication_manifest_missing_artifact",
    "publication_manifest_stale_baseline",
    "publication_manifest_date_mismatch",
    "publication_manifest_invalid_digest",
    "publication_manifest_unsupported_adapter",
    "frozen_media_mismatch",
    "frozen_watchlist_projection_mismatch",
    "image_structurally_valid_editorially_weak",
    "image_structurally_valid_generic",
    "image_duplicate_composition_set",
    "image_wrong_dimensions",
    "image_clipped_or_corrupt",
    "image_accessibility_missing",
    "image_benchmark_quality_pass",
    "image_quality_evidence_missing",
    "image_editorial_review_unavailable",
    "image_replacement_identity_not_versioned",
    "image_deployed_byte_mismatch",
    "image_historical_fixture_preserved",
    "canonical_status_completed",
    "canonical_status_running",
    "canonical_status_blocked_preserves_work",
    "canonical_status_failed",
    "canonical_status_candidate_ready",
    "canonical_status_merged_pages_pending",
    "canonical_status_pages_success_live_pending",
    "canonical_status_live_verified_cc_sync_pending",
    "command_center_exact_parity",
    "command_center_stale_copy_detected",
    "command_center_failed_refresh_not_current",
    "command_center_refresh_cannot_mutate_lifecycle",
    "no_fallback_verified_state",
    "wave5_clean_edition_qualifies",
    "wave5_unproven_metric_disqualifies",
    "wave5_consecutive_streak_resets",
    "wave5_recovery_qualification_matrix",
    "run_supervisor_worker_dies_mid_task",
    "run_supervisor_stale_active_without_owner_status",
    "run_supervisor_actionable_blocked_auto_recovery",
    "run_supervisor_watchdog_same_execution_restart",
    "run_supervisor_duplicate_run_rejected",
    "run_supervisor_stale_writer_fence_rejected",
    "operational_learning_full_ledger_inherited_at_task00",
    "operational_learning_new_problem_recorded_during_run",
    "task29_learning_reconciled_before_next_run_ready",
    "kanban_event_digest_drift_auto_repaired",
    "small_png_route_executable_task00_gate"
  ],
  "prohibitions": [
    "run_all_by_default_after_isolated_change",
    "broad_historical_replay_without_hypothesis",
    "rerun_passing_unaffected_tiers",
    "recreate_editorial_media_or_images_for_deterministic_tests"
  ]
}
