{
  "schema_version": "1.4.0",
  "contract_id": "continuous-qualification-v1",
  "effective_date": "2026-09-26",
  "repository": "gttome/Daily-AI-Brief",
  "timezone": "America/Chicago",
  "purpose": "Run publication-equivalent Daily Generative AI Brief qualification cycles repeatedly during stabilization without mutating production and without Work, Codex, or paid API usage.",
  "production_invariants": {
    "real_public_editions_per_day_max": 1,
    "production_main_mutation": false,
    "production_publication_pr": false,
    "publication_candidate_label": false,
    "production_pages_deployment": false,
    "production_command_center_sync": false,
    "production_novelty_memory_mutation": false,
    "production_ratings_analytics_mutation": false
  },
  "cadence": {
    "max_full_semantic_qualification_runs_per_chicago_day": 40,
    "targeted_deterministic_regressions_per_day": "unbounded_within_github_actions",
    "target_consecutive_full_passes": 5,
    "minimum_distinct_fresh_evidence_cutoffs_in_streak": 3,
    "final_graduation_requirement": "one subsequent real production edition reaches durable PUBLIC CLOSED under the same zero-Work/zero-Codex/zero-paid-API operating model"
  },
  "cost_boundary": {
    "work_usage_required": 0,
    "codex_usage_required": 0,
    "paid_api_usage_required": 0,
    "new_paid_services_required": 0,
    "new_credentials_required": 0,
    "overage_required": 0,
    "deterministic_model_calls_required": 0,
    "account_meter_policy": "Do not infer Work/Codex credit usage. When the platform exposes a balance, owner-observed before/after values may be attached as external evidence."
  },
  "run_identity": {
    "format": "YYYY-MM-DD-QN",
    "examples": [
      "2026-09-26-Q1",
      "2026-09-26-Q3",
      "2026-09-26-Q20",
      "2026-09-26-Q40"
    ],
    "preflight_branch": "discovery-preflight/qualification/YYYY-MM-DD-QN",
    "handoff_branch": "editorial-handoff/qualification/YYYY-MM-DD-QN",
    "semantic_receipt": "_records/qualification/YYYY-MM-DD-QN/semantic-receipt.json",
    "deterministic_result": "_records/qualification/YYYY-MM-DD-QN/result.json",
    "minimum_supported_slots_per_day": 20,
    "maximum_supported_slot_number": 40,
    "slot_number_range": "1..40"
  },
  "fresh_run_requirements": {
    "fresh_metadata_discovery": true,
    "fresh_cutoff": true,
    "bounded_article_evidence": true,
    "metadata_candidates_max": 20,
    "article_evidence_candidates_max": 9,
    "one_semantic_editorial_pass": true,
    "post_editorial_semantic_passes": 0,
    "stories": 6,
    "ordered_allocation": [
      "technical_ai_engineering",
      "technical_ai_engineering",
      "applied_genai_knowledge_workers",
      "applied_genai_knowledge_workers",
      "agents_non_technical_people",
      "agents_non_technical_people"
    ],
    "agent_skills_stories": 1,
    "videos": 2,
    "podcasts": 2,
    "fresh_watchlist_evaluation": true,
    "book_mapping_evaluation": true,
    "images": 6,
    "image_quality_baseline": "2026-09-17-or-better",
    "low_quality_fallback": false
  },
  "execution_ownership": {
    "preflight": "github_actions",
    "semantic_editorial_and_image_generation": "ordinary_chatgpt_without_Work_or_Codex",
    "deterministic_expansion_and_validation": "github_actions",
    "production_promotion": "prohibited"
  },
  "simulated_release_chain": [
    "PREFLIGHT_METADATA_READY",
    "PREFLIGHT_DISCOVERY_READY",
    "READINESS_FINAL",
    "EDITORIAL_KERNEL_READY",
    "MEDIA_READY",
    "IMAGES_READY",
    "WATCHLIST_READY",
    "HANDOFF_COMMITTED",
    "DETERMINISTIC_EXPANSION_READY",
    "FULL_QUALIFICATION_CI_PASS",
    "SIMULATED_LIVE_VALIDATION_PASS",
    "SIMULATED_CLOSED"
  ],
  "pass_criteria": {
    "owner_manual_github_ui_actions": 0,
    "owner_supplied_branch_names": 0,
    "owner_supplied_shas": 0,
    "repeated_completed_stages": 0,
    "duplicate_publication_prs": 0,
    "work_usage": 0,
    "codex_usage": 0,
    "paid_api_usage": 0,
    "critical_high_defects_open": 0,
    "deterministic_result": "pass",
    "simulated_lifecycle": "CLOSED"
  },
  "book_series_diversity": {
    "issue_id": "BQ-01",
    "minimum_distinct_books_in_reference_catalog": 4,
    "selection_rule": "semantic_relevance_first",
    "forced_daily_rotation": false,
    "rolling_observation_window_full_runs": 10,
    "dominant_reference_share_warning_threshold": 0.5,
    "graduation_gate": "All four books must be represented in the verified reference catalog before stabilization graduates to mature.",
    "current_known_gap": "The current production catalog has only three references across two books; recent use is over-concentrated in Reliable Generative AI Context Engineering Chapter 3."
  },
  "safety": {
    "protected_ci_bypass": false,
    "quality_gate_weakening": false,
    "sharing_access_change": false,
    "destructive_production_action": false,
    "merge_pr_117": false
  },
  "schedule_separation": {
    "production_schedules": [
      {
        "name": "Daily Brief Production Orchestrator",
        "time_chicago": "04:00",
        "scope": "production"
      },
      {
        "name": "Daily Brief Live Validation & Repair",
        "time_chicago": "08:30",
        "scope": "production"
      }
    ],
    "qualification_schedules": [
      {
        "name": "Qualification slots",
        "time_chicago": "individually scheduled",
        "run_slot": "Q1..Q40",
        "scope": "qualification_nonproduction"
      }
    ],
    "cross_lane_reuse_prohibited": true,
    "production_must_ignore_qualification_state": true,
    "qualification_must_not_invoke_production_schedule": true,
    "independently_pauseable": true,
    "dynamic_slot_addition_allowed": true,
    "slot_pause_resume_independent": true,
    "minimum_active_capacity_target": 20,
    "slot_terminal_guard_required": true,
    "slot_duplicate_run_guard_required": true
  },
  "qualification_novelty_baseline": {
    "rule": "Each full qualification run is an independent hypothetical production attempt for its edition date. Novelty must be evaluated against the production history that existed before that edition date, not against the real same-day production edition or prior Q-runs.",
    "production_history_cutoff": "strictly_before_edition_date",
    "exclude_real_same_day_production": true,
    "exclude_all_qualification_runs": true,
    "production_history_mutation": false,
    "reason": "Multiple same-day qualification runs would otherwise become impossible after the first real edition consumes the strongest 24-hour candidates. Isolation preserves the actual 30-day novelty rule while testing each Q-run as an independent production simulation.",
    "qualification_repeat_selection_allowed": true,
    "qualification_repeat_note": "The same source may appear in multiple Q-runs only if it was novel relative to the frozen pre-edition production history. Qualification repetition never authorizes a production repeat."
  },
  "image_execution_isolation": {
    "rule": "Every qualification image generation consumes one sealed single-story image packet and no other story or edition visual context.",
    "packet_per_story": true,
    "exactly_one_story_id_per_packet": true,
    "exactly_one_candidate_id_per_packet": true,
    "exclude_other_story_titles": true,
    "exclude_other_story_sources": true,
    "exclude_other_story_prompts": true,
    "exclude_edition_status_art": true,
    "rejected_wrong_subject_must_start_fresh_request": true,
    "rejected_wrong_subject_must_not_be_edited_or_reused": true,
    "acceptance_order": [
      "subject_identity",
      "factual_support",
      "structural_quality",
      "editorial_quality"
    ],
    "receipt_required_per_story": true,
    "receipt_fields": [
      "story_id",
      "candidate_id",
      "request_sha256",
      "subject_match",
      "factual_support",
      "quality_result",
      "accepted_sha256"
    ],
    "low_quality_fallback": false,
    "q1_root_cause": "Q1 produced repeated wrong-subject/unsupported-detail image attempts despite the post-generation gate; isolation must be enforced before generation as well as after review."
  },
  "qualification_novelty_preflight": {
    "enforced_before_semantic": true,
    "production_history_cutoff": "strictly_before_edition_date",
    "exclude_real_same_day_production": true,
    "exclude_all_qualification_runs": true,
    "exact_source_prior_production_eligible": false,
    "material_update_exception_requires_verified": true,
    "required_output_fields": [
      "production_novelty_eligible",
      "production_novelty_reason",
      "agent_skill_story_ready_signals_after_novelty"
    ],
    "fail_closed_code": "qualification_agent_skill_unavailable_after_novelty",
    "semantic_must_not_start_when_agent_skill_ready_after_novelty_is_zero": true
  }
}
