{
  "schema_version": "1.4.0",
  "profile_id": "under80-v1",
  "effective_date": "2026-09-19",
  "baseline_date": "2026-09-17",
  "daily_system_credit_target_lt": 80,
  "credit_admission_threshold": 65,
  "cost_scope": "publisher+failed_attempts+recovery+validation+command_center_ai+edition_related_maintenance",
  "cost_qualification_runs": 3,
  "daily_ai_task_limit": 1,
  "daily_validation_ai_tasks": 0,
  "metadata_candidate_limit": 20,
  "normal_deep_review_limit": 9,
  "exception_deep_review_limit": 9,
  "deep_review_expansion_enabled": false,
  "model_visible_evidence_char_limit": 12000,
  "semantic_rule_context_char_limit": 4000,
  "research_capsule_char_limit": 6500,
  "work_context_char_limit": 6500,
  "normal_editorial_model_passes": 1,
  "normal_post_editorial_model_passes": 0,
  "normal_validation_model_passes": 0,
  "broad_fallback_searches": 0,
  "automatic_ai_recovery_runs": 0,
  "ai_release_polling": 0,
  "network_transient_retry_limit": 1,
  "reader_focus_order": [
    "agents_non_technical_people",
    "applied_genai_knowledge_workers",
    "technical_ai_engineering"
  ],
  "canonical_focus_order_unchanged": true,
  "visual_quality_baseline": "2026-09-17",
  "image": {
    "method": "current_openai_generation_with_accepted_asset_reuse",
    "quality_protected": true,
    "required_story_images": 6,
    "reuse_accepted_on_recovery": true,
    "batch_regeneration_on_unrelated_failure": false,
    "alternative_requires_side_by_side_equivalence": true,
    "binary_transport": "github_git_data_api",
    "github_contents_api_for_png": false,
    "prepush_integrity_validator": "_tools/validate-handoff-images.mjs",
    "github_git_data_blob_encoding": "base64",
    "native_git_credentials_required": false,
    "connector_git_data_tools": [
      "create_blob",
      "create_tree",
      "create_commit",
      "update_ref"
    ],
    "accepted_asset_lock": true,
    "accepted_asset_lock_effective_date": "2026-09-19",
    "canonical_public_origin": "https://gttome.github.io/Daily-AI-Brief/",
    "command_center_is_authoritative_host": false,
    "regenerate_locked_asset_only_if": [
      "story_materially_changed",
      "asset_missing",
      "asset_corrupt",
      "explicit_editorial_rejection"
    ]
  },
  "video": {
    "preferred_count": 2,
    "minimum_desirable_count": 2,
    "deep_review_max": 5,
    "duration_tiers_seconds": [
      600,
      900,
      1200
    ],
    "required_count": 2
  },
  "podcast": {
    "target_count": 2,
    "max_ai_daily_brief_per_edition": 1,
    "require_different_sources_when_two_selected": true,
    "maximum_duration_seconds": null,
    "required_count": 2
  },
  "deterministic_validation": {
    "model_calls": 0,
    "trigger": "pages_completion_with_09_chicago_fallback",
    "work_validator_cutover": "after_first_successful_live_deterministic_receipt"
  },
  "autonomous_main_merge_enabled": true,
  "autonomous_merge_scope": "same_repository_open_non_draft_pr_labeled_publication-candidate_with_exact_successful_required_ci_head",
  "release_authorization": "2026-09-18 user proceed for scoped under80 implementation; platform and repository enforcement remain authoritative",
  "no_added_cost": true,
  "no_new_credentials": true,
  "failure_policy": "preserve_last_valid_edition_and_stop_without_same_edition_ai_retry",
  "runtime_contract_path": "docs/operations/under80-runtime-contract.json",
  "daily_work_reads_historical_runbook": false,
  "post_editorial_execution_owner": "github_actions",
  "work_stop_boundary": "after one accepted editorial bundle, six accepted full-quality images, local PNG integrity validation, and one atomic Git Data API handoff commit on an isolated branch",
  "work_forbidden_after_handoff": [
    "deterministic generator",
    "repository test suite",
    "contract validation",
    "Jekyll build",
    "publication PR creation",
    "CI polling",
    "merge polling",
    "Pages polling",
    "post-deployment validation",
    "Command Center synchronization"
  ],
  "handoff_branch_prefix": "editorial-handoff/",
  "handoff_manifest_path": "_records/editorial-handoff/handoff.json",
  "qualification_nonproduction": {
    "execution_mode": "qualification_nonproduction",
    "branch_prefix": "editorial-handoff/qualification/",
    "production_pr": false,
    "publication_candidate_label": false,
    "merge_to_main": false,
    "pages_deployment": false,
    "production_mutation": false,
    "deterministic_branch_validation": true
  },
  "metadata_gate": {
    "tool": "_tools/under80-metadata-gate.mjs",
    "output_path": "_records/editorial-handoff/metadata-candidates.json",
    "raw_discovery_queue_model_visible": false,
    "retained_candidate_limit": 20,
    "required_before_deep_review": true,
    "rule": "Raw catalog/discovery results are traceability-only. The editorial model may inspect only the deterministic gate output containing at most 20 retained metadata candidates.",
    "fresh_discovery_required": true,
    "discovery_cutoff_env": "DAB_RESEARCH_CUTOFF",
    "resolved_date_required": true,
    "coverage_minimum_per_focus": 3,
    "agent_skill_signals_minimum": 1,
    "coverage_ready_required": true,
    "prefer_publisher_feeds": true,
    "required_topic_sources": "_data/required-topic-sources.json",
    "prework_owner": "github_actions",
    "preflight_workflow": ".github/workflows/under80-metadata-preflight.yml",
    "work_executes_metadata_discovery": false,
    "work_entry_requires_ready_preflight": true,
    "preflight_branch_prefix": "preflight/",
    "model_calls": 0,
    "credit_goal": "zero Work/Codex credits for metadata discovery and prefilter",
    "date_enrichment": {
      "owner": "github_actions",
      "tool": "_tools/enrich-metadata-dates.mjs",
      "attempt_limit": 48,
      "model_calls": 0,
      "work_credits_expected": 0
    },
    "preflight_source_plan": "_data/preflight-source-plan.json",
    "balanced_source_hints": true,
    "balanced_date_enrichment": true,
    "agent_skill_story_ready_signals_minimum": 1,
    "agent_skill_updated_at_requires_material_change_verification": true
  },
  "work_forbidden_before_editorial": [
    "metadata catalog discovery",
    "broad source scanning",
    "raw discovery queue inspection"
  ],
  "discovery_preflight": {
    "execution_owner": "github_actions",
    "workflow": ".github/workflows/under80-discovery-preflight.yml",
    "model_calls": 0,
    "work_catalog_discovery_allowed": false,
    "raw_discovery_queue_model_visible": false,
    "max_retained_candidates": 20,
    "coverage_ready_required": true,
    "daily_branch_pattern": "discovery-preflight/daily/YYYY-MM-DD",
    "qualification_branch_pattern": "discovery-preflight/qualification/YYYY-MM-DD-<attempt>",
    "rationale": "The September 18 qualification attempt consumed 58 Work credits before deep review while only running deterministic discovery/gating; moving this stage to GitHub Actions preserves quality while removing it from Work/Codex cost.",
    "agent_skill_story_ready_required": true
  },
  "article_evidence_preflight": {
    "execution_owner": "github_actions",
    "model_calls": 0,
    "candidate_count": 9,
    "focus_distribution": "3/3/3",
    "work_network_article_retrieval": false,
    "model_visible_chars_max": 12000
  },
  "handoff_transport": {
    "method": "github_git_data_api",
    "authenticated_by_existing_github_connector": true,
    "added_credentials": false,
    "contents_api_binary_writes": false,
    "native_git_authentication": false,
    "atomic_ref_update": true
  },
  "watchlist": {
    "minimum_fresh_observations": 12,
    "max_fallback_checks": 20,
    "daily_edition_date_required": true
  },
  "autonomous_pr_creation_repository_setting": "Settings > Actions > General > Workflow permissions > Allow GitHub Actions to create and approve pull requests"
}
