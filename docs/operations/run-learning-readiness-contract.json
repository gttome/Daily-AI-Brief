{
  "schema_version": "run-learning-readiness-v2",
  "purpose": "Mandatory cumulative learning, persistent supervision, cleanup and readiness contract for every Daily AI Brief production run.",
  "start_gate": {
    "task_id": "00",
    "name": "Production Readiness Validation",
    "must_pass_before_content_production": true,
    "latest_successful_run_inheritance_required": true,
    "full_operational_learning_ledger_required": true,
    "checks": [
      "operational_learning_ledger_digest",
      "all_permanent_fixes_present",
      "unresolved_risks_loaded",
      "one_writer",
      "run_supervisor_enabled_and_bound",
      "supervisor_heartbeat_90s_or_less",
      "outer_watchdog_enabled",
      "writer_fencing_enabled",
      "stale_active_recovery_fault_test",
      "actionable_blocked_recovery_fault_test",
      "duplicate_run_rejection_fault_test",
      "proven_production_image_path",
      "svg_fallback_disabled",
      "low_quality_fallback_disabled",
      "exact_byte_capture",
      "small_png_persistence_route_available",
      "small_png_readback_identity_verified",
      "append_only_transition_ledger",
      "kanban_digest_bound_projection",
      "executor_state_visible",
      "cost_boundary",
      "protected_ci",
      "exact_sha_deploy",
      "independent_live_verification",
      "previous_run_cleanup_pass"
    ]
  },
  "supervisor": {
    "version": "run-supervisor-v2",
    "interval_seconds": 60,
    "lifecycle": "Task 00 PASS through Task 29 PASS",
    "worker_count": 1,
    "writer_authority_count": 1,
    "writer_fencing": true,
    "outer_watchdog_minutes": 5,
    "duplicate_run_policy": "reject any second nonterminal execution; resume only exact same execution identity",
    "states": [
      "HEALTHY_ACTIVE",
      "READY_IDLE",
      "STALE_ACTIVE",
      "BLOCKED_ACTIONABLE",
      "BLOCKED_EXTERNAL",
      "TERMINAL"
    ],
    "status_requests_are_read_only": true,
    "github_actions_job_rotation": "Supervisor may rotate before GitHub-hosted job timeout; successor resumes same execution identity under a new fence."
  },
  "task_recovery_contracts": {
    "path": "docs/operations/task-recovery-contracts.json",
    "tasks": "00-29",
    "required_fields": [
      "normal_operation",
      "success_evidence",
      "stale_after_seconds",
      "first_recovery",
      "alternate_recovery",
      "retry_limit",
      "terminal_failure_condition",
      "invalidate_downstream",
      "simplification_rule"
    ]
  },
  "operational_learning": {
    "canonical_jsonl": "data/operations/production-continuous-improvement-ledger.jsonl",
    "human_projection": "docs/operations/PRODUCTION-CONTINUOUS-IMPROVEMENT-LEDGER.md",
    "run_delta_pattern": "_records/run-learning/incidents/<execution_id>.jsonl",
    "task00": "Read and validate full canonical ledger; bind digest/invariant set into readiness.",
    "during_run": "Append every material problem and fix attempt to the run-scoped durable GitHub delta as it occurs.",
    "task29": "Merge run delta into canonical ledger; reconcile every problem; add regression protection; update timing baseline and next-run invariants."
  },
  "liveness": {
    "stale_active_threshold_minutes_max": 15,
    "supervisor_check_seconds_target": 60,
    "silent_active_stall_prohibited": true,
    "actionable_blocked_wait_for_owner_prohibited": true
  },
  "image_path": {
    "required": "production-image-execution-v2:generate-transfer-verify-review-accept",
    "svg_fallback": false,
    "low_quality_fallback": false,
    "small_png_transport": {
      "required_every_run": true,
      "primary": "direct_git_data_create_blob_base64",
      "fallback": "bounded_base64_chunk_bridge",
      "sequence": [
        "capture_exact_png_bytes_immediately",
        "persist_exact_bytes",
        "verify_content_identity",
        "review_saved_git_asset",
        "accept_or_retry"
      ],
      "prohibit": [
        "owner_upload",
        "conversation_scavenging_as_primary_recovery",
        "regenerate_while_exact_bytes_are_recoverable",
        "new_transport_architecture_when_primary_or_fallback_is_available"
      ]
    }
  },
  "kanban": {
    "authoritative_source": "append_only_transition_events",
    "projection_only": true,
    "source_digest_required": true,
    "supervisor_repairs_stale_projection": true
  },
  "terminal_cleanup": {
    "final_task_id": "29",
    "name": "Run Cleanup + Continuous Improvement + Next-Run Readiness",
    "required_after": [
      "PUBLIC_CLOSED",
      "FAILED"
    ],
    "checks": [
      "disable_run_specific_executors",
      "no_active_writer",
      "reconcile_transition_ledger",
      "reconcile_kanban",
      "freeze_timers",
      "preserve_production_state",
      "clear_active_run_pointer",
      "merge_operational_learning_delta",
      "certify_run_learning",
      "promotion_review_complete",
      "timing_comparison_complete",
      "regression_protection_updated",
      "next_run_invariant_set_complete",
      "write_cleanup_receipt"
    ]
  },
  "success_state": "PUBLIC_CLOSED",
  "cost_boundary": {
    "chatgpt_work": false,
    "codex": false,
    "paid_apis": false,
    "billable_overage": false,
    "alternate_accounts": false,
    "new_credentials": false,
    "github_runner": "standard public-repository runner only"
  }
}
